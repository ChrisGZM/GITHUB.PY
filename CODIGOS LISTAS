# PROGRAMA PARA CONTAR NÚMEROS PARES E IMPARES EN UNA LISTA

def contar_pares_impares(numeros):
    pares = 0
    impares = 0
    for num in numeros:
        if num % 2 == 0:
            pares += 1
        else:
            impares += 1
    return pares, impares

numeros = []
for i in range(10):
    num = int(input("Número {}: ".format(i+1)))
    numeros.append(num)

p, i = contar_pares_impares(numeros)
print("Pares:", p)
print("Impares:", i)

# PROGRAMA PARA SUMAR ELEMENTOS DE UNA LISTA (MANUAL Y CON SUM)

def sumar_lista(lista):
    suma = 0
    for num in lista:
        suma += num
    return suma

numeros = []
for i in range(5):
    valor = int(input(f"Ingrese número {i+1}: "))
    numeros.append(valor)

total = sumar_lista(numeros)
total_sum = sum(numeros) # usando función built-in

print("Suma con bucle:", total)
print("Suma con sum():", total_sum)

# PROGRAMA PARA OBTENER EL VALOR MÁXIMO Y MÍNIMO DE UNA LISTA MANUALMENTE

def maximo_manual(lista):
    if len(lista) == 0:
        return None
    maximo = lista[0]
    for num in lista:
        if num > maximo:
            maximo = num
    return maximo

def minimo_manual(lista):
    if len(lista) == 0:
        return None
    minimo = lista[0]
    for num in lista:
        if num < minimo:
            minimo = num
    return minimo

numeros = []
for i in range(8):
    valor = int(input(f"Número {i+1}: "))
    numeros.append(valor)

mayor_manual = maximo_manual(numeros)
menor_manual = minimo_manual(numeros)

print("Mayor (manual):", mayor_manual)
print("Menor (manual):", menor_manual)

# PROGRAMA PARA INVERTIR EL ORDEN DE UNA LISTA CON UN BUCLE REVERSO

def invertir_manual(lista):
    invertida = []
    for i in range(len(lista) - 1, -1, -1):
        invertida.append(lista[i])
    return invertida

numeros = []
for i in range(6):
    valor = int(input(f"Número {i+1}: "))
    numeros.append(valor)

print("Original:", numeros)

invertida = invertir_manual(numeros)
print("Invertida:", invertida)
